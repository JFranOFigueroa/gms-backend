<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot 4 gestiona su propio Hibernate/JPA, Bean Validation, Jackson y logging.
  WildFly 40 estándar aporta Jakarta EE 11 (Servlet 6.1, JPA 3.2, Validation 3.1),
  pero la aplicación no usa CDI ni JSF: se excluyen esos subsistemas para evitar
  que Weld/ValidationInterceptor procesen los jars de Spring en WEB-INF/lib.

  La exclusión de "logging" es obligatoria: sin ella WildFly añade su módulo
  org.slf4j (binding slf4j-jboss-logmanager) y, como las dependencias de sistema
  tienen prioridad sobre WEB-INF/lib, Logback queda desactivado y Spring Boot
  falla con "LoggerFactory is not a Logback LoggerContext". Al excluir el
  subsistema, la app usa su propio SLF4J + Logback.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
  <deployment>
    <exclude-subsystems>
      <subsystem name="jpa"/>
      <subsystem name="bean-validation"/>
      <subsystem name="weld"/>
      <subsystem name="jsf"/>
      <subsystem name="logging"/>
    </exclude-subsystems>
  </deployment>
</jboss-deployment-structure>
