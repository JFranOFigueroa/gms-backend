<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot 4 gestiona su propio Hibernate/JPA, Bean Validation y Jackson.
  WildFly 40 estándar aporta Jakarta EE 11 (Servlet 6.1, JPA 3.2, Validation 3.1),
  pero la aplicación no usa CDI ni JSF: se excluyen esos subsistemas para evitar
  que Weld/ValidationInterceptor procesen los jars de Spring en WEB-INF/lib.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
  <deployment>
    <exclude-subsystems>
      <subsystem name="jpa"/>
      <subsystem name="bean-validation"/>
      <subsystem name="weld"/>
      <subsystem name="jsf"/>
      <subsystem name="logging"/>
    </exclude-subsystems>
    <exclusions>
      <module name="org.hibernate"/>
      <module name="org.hibernate.envers"/>
      <module name="org.hibernate.validator"/>
      <module name="org.jboss.as.jpa"/>
      <module name="org.slf4j.impl"/>
    </exclusions>
  </deployment>
</jboss-deployment-structure>
