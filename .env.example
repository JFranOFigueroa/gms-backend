# Copiar a .env y personalizar. NO subir .env a Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymback
DB_USER=gymback
DB_PASSWORD=CHANGE_ME
schema_db=test
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# >= 32 caracteres aleatorios distintos en cada ambiente; NO usar el ejemplo en producción.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Creación controlada de primera cuenta admin. Dejar vacío tras arrancar una vez.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
