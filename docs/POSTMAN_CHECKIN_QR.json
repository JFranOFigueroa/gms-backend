    {
      "name": "07 Activar kiosco",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/kiosk/activate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "kiosk",
            "activate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"{{slug}}\",\n  \"activationCode\": \"{{activationCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "08 Sesión kiosco y CSRF",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/kiosk/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "kiosk",
            "session"
          ]
        },
        "description": "Requiere cookie de sesión de kiosco GMS_KIOSK, obtenida al activar y administrada por el cliente HTTP."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const payload = pm.response.json();",
              "  pm.environment.set(\"csrfToken\", payload.csrfToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Emitir QR del gimnasio",
      "request": {
        "method": "POST",
        "header": [
