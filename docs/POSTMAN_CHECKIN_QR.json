{
  "info": {
    "name": "GMS — Check-in QR, kiosco y código manual (backend V6)",
    "description": "Endpoints nuevos. Activar kiosco con Origin del frontend; guardar cookie de sesión y csrfToken; usar UUID nuevo por intento y reutilizarlo solo en reintentos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Configuración pública",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/gyms/{{slug}}/checkin-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "gyms",
            "{{slug}}",
            "checkin-config"
          ]
        }
      },
      "response": []
    },
